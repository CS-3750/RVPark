@page
@model RVPark.Application.Pages.Admin.EditUserModel
@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-start mb-3">
        <a href="/admin/admintools" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Admin Tools
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0" style="font-size: 1.5rem;">User Management</h2>
            <a href="/admin/createuser" class="btn btn-light btn-sm">
                <i class="bi bi-person-plus"></i> Create New User
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Status</th>
                            <th>Assigned Projects</th>
                            <th style="width: 180px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge bg-@(user.Role == "Admin" ? "danger" : user.Role == "Intern" ? "warning" : "info")">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-@(user.IsActive ? "success" : "secondary")">
                                        @(user.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @if (user.AssignedProjects.Any())
                                    {
                                        <small>@string.Join(", ", user.AssignedProjects.Take(2))@(user.AssignedProjects.Count > 2 ? "..." : "")</small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">None</small>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-primary btn-sm me-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#editUserModal"
                                            onclick="populateEditModal('@user.Id', '@user.FirstName', '@user.LastName', '@user.Email', '@user.Role', @(user.IsActive ? "true" : "false"), '@string.Join(",", user.AssignedProjectIds)')">
                                        <i class="bi bi-pencil"></i> Edit
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@user.Id" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form method="post" asp-page-handler="EditUser">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" asp-for="EditInput.Id" />
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="EditInput.FirstName" class="form-control" placeholder="First Name" />
                                <label asp-for="EditInput.FirstName">First Name</label>
                                <span asp-validation-for="EditInput.FirstName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input asp-for="EditInput.LastName" class="form-control" placeholder="Last Name" />
                                <label asp-for="EditInput.LastName">Last Name</label>
                                <span asp-validation-for="EditInput.LastName" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="form-floating">
                            <input asp-for="EditInput.Email" class="form-control" placeholder="Email" type="email" />
                            <label asp-for="EditInput.Email">Email</label>
                            <span asp-validation-for="EditInput.Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <div class="form-floating">
                                <select asp-for="EditInput.Role" class="form-select" asp-items="Model.RoleOptions">
                                    <option value="">Select a role...</option>
                                </select>
                                <label asp-for="EditInput.Role">Role</label>
                                <span asp-validation-for="EditInput.Role" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3 d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input asp-for="EditInput.IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="EditInput.IsActive" class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Assign to Projects</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (Model.ProjectOptions.Any())
                            {
                                @for (int i = 0; i < Model.ProjectOptions.Count; i++)
                                {
                                    <div class="form-check">
                                        <input type="checkbox" 
                                               name="EditInput.SelectedProjectIds" 
                                               value="@Model.ProjectOptions[i].Value" 
                                               class="form-check-input project-checkbox" 
                                               id="edit_project_@Model.ProjectOptions[i].Value" />
                                        <label class="form-check-label" for="edit_project_@Model.ProjectOptions[i].Value">
                                            @Model.ProjectOptions[i].Text
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">No projects available</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function populateEditModal(id, firstName, lastName, email, role, isActive, projectIds) {
            document.querySelector('input[name="EditInput.Id"]').value = id;
            document.querySelector('input[name="EditInput.FirstName"]').value = firstName;
            document.querySelector('input[name="EditInput.LastName"]').value = lastName;
            document.querySelector('input[name="EditInput.Email"]').value = email;
            document.querySelector('select[name="EditInput.Role"]').value = role;
            document.querySelector('input[name="EditInput.IsActive"]').checked = isActive === 'true';
            
            // Clear all project checkboxes first
            document.querySelectorAll('.project-checkbox').forEach(cb => cb.checked = false);
            
            // Check assigned projects
            if (projectIds) {
                const assignedIds = projectIds.split(',');
                assignedIds.forEach(projectId => {
                    const checkbox = document.querySelector(`#edit_project_${projectId}`);
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                });
            }
        }
    </script>
}