@page
@model RVPark.Web.Pages.Admin.CreateUserModel
@{
    ViewData["Title"] = "Create User";
}

<div class="container mt-5" style="max-width: 800px;">
    <div class="d-flex justify-content-start mb-3">
        <a href="/admin/edituser" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to User Management
        </a>
    </div>
    
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0" style="font-size: 1.5rem;">Create New User</h2>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                            <label asp-for="Input.FirstName">First Name</label>
                            <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                            <label asp-for="Input.LastName">Last Name</label>
                            <span asp-validation-for="Input.LastName" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Input.Email" class="form-control" placeholder="Email" type="email" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <div class="form-floating">
                            <select asp-for="Input.Role" class="form-select" asp-items="Model.RoleOptions">
                                <option value="">Select a role...</option>
                            </select>
                            <label asp-for="Input.Role">Role</label>
                            <span asp-validation-for="Input.Role" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3 d-flex align-items-center">
                        <div class="form-check form-switch">
                            <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" role="switch" />
                            <label asp-for="Input.IsActive" class="form-check-label">Active User</label>
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">Assign to Projects (Optional)</label>
                    <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                        @if (Model.ProjectOptions.Any())
                        {
                            @for (int i = 0; i < Model.ProjectOptions.Count; i++)
                            {
                                <div class="form-check">
                                    <input type="checkbox" 
                                           name="Input.SelectedProjectIds" 
                                           value="@Model.ProjectOptions[i].Value" 
                                           class="form-check-input" 
                                           id="project_@Model.ProjectOptions[i].Value" />
                                    <label class="form-check-label" for="project_@Model.ProjectOptions[i].Value">
                                        @Model.ProjectOptions[i].Text
                                    </label>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No projects available</p>
                        }
                    </div>
                    <small class="form-text text-muted">
                        User permissions will be set based on their role. Admins get full permissions, Interns get contributor permissions, and Clients get view-only permissions.
                    </small>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="/admin/edituser" class="btn btn-outline-secondary me-md-2">Cancel</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-person-plus"></i> Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}