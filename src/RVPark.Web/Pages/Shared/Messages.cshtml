@page "{projectId:int?}"
@model RVPark.Web.Pages.Shared.MessagesModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Messages";
}

<h1>@ViewData["Title"]</h1>

@if (Model.CurrentProject != null)
{
    <ul class="nav nav-tabs">
        @foreach (var project in Model.UserProjects)
        {
            <li class="nav-item">
                <a class="nav-link @(project.Id == Model.CurrentProject.Id ? "active" : "")" asp-page="./Messages" asp-route-projectId="@project.Id">@project.Title</a>
            </li>
        }
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active">
            <div class="row mt-3">
                <div class="col-md-8">
                    <section>
                        <h4>Send a new message for project: @Model.CurrentProject.Title</h4>
                        <hr />
                        <form method="post">
                            <input type="hidden" asp-for="NewMessage.ProjectId" value="@Model.CurrentProject.Id" />

                            <div class="mb-3">
                                <label asp-for="NewMessage.ReceiverId" class="form-label">To</label>
                                <select asp-for="NewMessage.ReceiverId" class="form-select">
                                    <option value="" selected disabled>-- Select a Recipient --</option>
                                    @foreach (var user in Model.Users)
                                    {
                                        <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                                    }
                                </select>
                            </div>
                            <div class="mb-3">
                                <label asp-for="NewMessage.Content" class="form-label">Message</label>
                                <textarea asp-for="NewMessage.Content" class="form-control" rows="4"></textarea>
                            </div>
                            <div class="mb-3">
                                <button type="submit" class="btn btn-primary">Send</button>
                            </div>
                        </form>
                    </section>

                    <section class="mt-5">
                        <h4>Your Conversations for project: @Model.CurrentProject.Title</h4>
                        <hr />
                        @if (Model.Messages.Any())
                        {
                            @foreach(var message in Model.Messages.OrderByDescending(m => m.CreatedAt))
                            {
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <strong>From:</strong> @message.Sender.FirstName @message.Sender.LastName
                                        <span class="text-muted float-end">@message.CreatedAt.ToLocalTime().ToString("f")</span>
                                    </div>
                                    <div class="card-body">
                                        <p class="card-text">@message.Content</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No messages in this project yet.</p>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p>You are not assigned to any projects. You cannot send or receive messages.</p>
}