@page
@model RVPark.Web.Pages.Shared.MessagesModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Messages";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8">
        <section>
            <h4>Send a new message</h4>
            <hr />
            <form method="post">
                @* You will need to manage the ProjectId. For now, it's hardcoded. *@
                <input type="hidden" asp-for="NewMessage.ProjectId" value="1" />

                <div class="mb-3">
                    <label asp-for="NewMessage.ReceiverId" class="form-label">To</label>
                    <select asp-for="NewMessage.ReceiverId" class="form-select">
                        <option value="" selected disabled>-- Select a Recipient --</option>
                        @foreach (var user in Model.Users)
                        {
                            <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="NewMessage.Content" class="form-label">Message</label>
                    <textarea asp-for="NewMessage.Content" class="form-control" rows="4"></textarea>
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Send</button>
                </div>
            </form>
        </section>
        
        <section class="mt-5">
            <h4>Your Conversations</h4>
            <hr />
            @foreach(var message in Model.Messages.OrderByDescending(m => m.CreatedAt))
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>From:</strong> @message.Sender.FirstName @message.Sender.LastName
                        <span class="text-muted float-end">@message.CreatedAt.ToLocalTime().ToString("f")</span>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@message.Content</p>
                    </div>
                </div>
            }
        </section>
    </div>
</div>
