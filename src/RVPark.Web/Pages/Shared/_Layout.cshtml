@using Microsoft.AspNetCore.Identity
@using RVPark.Core.Interfaces
@using RVPark.Core.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager

@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Concept Center</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/images/concept_center_logo_transparent_bg.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.css">
</head>
<body>

    <div class="wrapper">
        <nav class="sidebar-persistent py-3 px-1 d-flex flex-column">
            <div class="col-md-10 offset-1 mt-2 mb-3 py-2">
                <a asp-page="/Shared/Projects/Index">
                    <img src="~/images/wsu_concept_center_logo.svg" alt="The Concept Center" />
                </a>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <ul class="nav flex-column mb-auto">
                    @* Account *@
                    <li class="nav-item">
                        <h6>
                            <a class="nav-link text-white text-truncate d-inline-block" style="max-width: 180px;" asp-area="Identity" asp-page="/Account/Manage/Index">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity?.Name
                            </a>
                        </h6>
                    </li>
                    <li class="nav-item">
                        <h6> 
                            <a class="nav-link text-white" asp-page="/Shared/Projects/Index">
                                <i class="bi bi-folder-plus me-1"></i>
                                Projects
                            </a>
                        </h6>
                    </li>
                    
                    @* Admin Tools *@
                    @if (await UserManager.IsInRoleAsync(user, "Admin"))
                    {
                        <li class="nav-item">
                            <h6>
                                <a class="nav-link text-white" href="/admin/admintools">
                                    <i class="bi bi-wrench-adjustable-circle me-1"></i>
                                    Admin Tools
                                </a>
                            </h6>
                        </li>
                    }
                    
                    @* Messages *@
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/shared/messages">
                            Messages
                        </a>
                    </li>
                </ul>
            }

            <!--Bottom of nav-->
            <div class="mt-auto">
                <ul class="nav flex-column mb-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <h6>
                                <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Logout">
                                    <i class="bi bi-door-open me-1"></i>
                                    Logout
                                </a>
                            </h6>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <h6>
                                <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Login">
                                    <i class="bi bi-person-badge me-1"></i>
                                    Login
                                </a>
                            </h6>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.umd.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>