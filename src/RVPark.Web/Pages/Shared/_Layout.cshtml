@using Microsoft.AspNetCore.Identity
@using RVPark.Core.Interfaces
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IProjectService ProjectService

@{
    var user = await UserManager.GetUserAsync(User);
    var projectList = user != null ? await ProjectService.GetUserProjectsAsync(user.Id) : [];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Concept Center</title>
    <script type="importmap"></script>
    <link rel="icon" type="image/png" href="~/images/concept_center_logo_transparent_bg.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.css">
</head>
<body>

    <div class="wrapper">
        <nav class="sidebar-persistent p-3 d-flex flex-column">
            <div class="my-2 py-2">
                <a asp-page="/Shared/Projects/Index">
                    <img src="~/images/wsu_concept_center_logo.svg" alt="The Concept Center" />
                </a>
            </div>
            @if (SignInManager.IsSignedIn(User))
            {
                <ul class="nav flex-column mb-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white text-truncate d-inline-block" style="max-width: 150px;" asp-area="Identity" asp-page="/Account/Manage/Index">
                            @User.Identity?.Name
                        </a>
                    </li>
                    <hr />
                    <li class="nav-item">
                        <a class="nav-link text-white" asp-page="/Shared/Projects/Index">
                            Projects
                        </a>
                    </li>
                    @if (await UserManager.IsInRoleAsync(user, "Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/admin/admintools">
                                Admin Tools
                            </a>
                        </li>
                    }
                </ul>
            }

            <!--Bottom of nav-->
            <div class="mt-auto">
                <ul class="nav flex-column mb-auto">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Logout">
                                Logout
                            </a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Login">
                                Login
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/frappe-gantt/dist/frappe-gantt.umd.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>