@using Microsoft.AspNetCore.Identity
@using RVPark.Core.Interfaces
@inject UserManager<IdentityUser> UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IProjectService ProjectService

@{
    var user = await UserManager.GetUserAsync(User);
    var projectList = user != null ? await ProjectService.GetUserProjectsAsync(user.Id) : [];
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RVPark.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<body>

<div class="wrapper">
    <nav class="sidebar-persistent p-3 d-flex flex-column">
        <h4 class="text-white mb-4">RVPark</h4>
        @if (SignInManager.IsSignedIn(User))
        {
            <ul class="nav flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Identity" asp-page="/Account/Manage/Index">
                        @User.Identity?.Name
                    </a>
                </li>
                <hr/>
                <li class="nav-item">
                    @* data-bs-toggle="offcanvas" data-bs-target="#projectsOffcanvas" aria-controls="projectsOffcanvas" *@
                    <a class="nav-link text-white" asp-page="/Shared/Projects/Index">
                        Projects
                    </a>
                </li>
            </ul>
        }
        
        <!--Bottom of nav-->
        <div class="mt-auto">
            <ul class="nav flex-column mb-auto">
                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Logout">
                            Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link active text-white" asp-area="Identity" asp-page="/Account/Login">
                            Login
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>

    <main class="main-content">
        @RenderBody()
    </main>
</div>

<div class="offcanvas offcanvas-start secondary-offcanvas bg-light" tabindex="-1" id="projectsOffcanvas" aria-labelledby="projectsOffcanvasLabel">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title text-dark" id="projectsOffcanvasLabel">Your Projects</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <ul class="list-group list-group-flush">
            @ViewData["Thing"]
            @foreach (var project in projectList)
            {
                <li class="list-group-item"><a href="#" class="text-decoration-none text-dark">@project.Name</a></li>
            }
        </ul>
        <hr>
        <div class="d-grid">
            <button class="btn btn-outline-primary">Add New Project</button>
        </div>
    </div>
</div>

</body>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>