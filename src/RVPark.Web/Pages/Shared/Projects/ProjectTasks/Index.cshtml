@page "/Shared/Projects/{projectId:int}/ProjectTasks"
@model IndexModel
@{
    ViewData["Title"] = "Project Tasks";
}

<div class="container my-4">
    <div class="card col-md-10 offset-1 mt-3 px-5 py-3">

        <div class="row mb-4">
            <a asp-page="/Shared/Projects/Upsert"
               asp-route-id="@Model.ProjectId"
               class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover position-absolute top-0 start-0 m-4">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
        
        <div class="row">
            <div class="col-md-10 offset-md-1">
                <!-- Page Title -->
                <div class="row my-4">
                    <h1 class="mb-3">
                        <i class="bi bi-list-check me-2"></i>
                        Tasks - @Model.Project.Title
                    </h1>
                </div>

                <!-- Filters + Search -->
                <div class="row mb-4 gy-2 gx-3 align-items-center">
                    <div class="col-auto">
                        <div class="input-group">
                            <span class="input-group-text">Status</span>
                            <select id="statusFilter" class="form-select">
                                <option value="All" selected>All</option>
                                <option value="Scheduled">Scheduled</option>
                                <option value="Active">Active</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-auto ms-auto d-flex align-items-center flex-nowrap">
                        <div class="input-group">
                            <input type="text" id="searchInput" class="form-control" placeholder="Search project tasks..." />
                            <button class="btn btn-outline-secondary" id="searchButton">Search</button>
                        </div>
                        <a asp-page="/Shared/Projects/ProjectTasks/Upsert"
                            asp-route-projectId="@Model.ProjectId"
                            asp-route-projectTaskId=0
                            class="btn btn-primary ms-2 text-nowrap">
                            <i class="bi bi-list-check me-1"></i>
                            New Task
                        </a>
                    </div>
                </div>

                <!-- Tasks Grid -->
                <div class="row" id="projectsContainer">
                    @foreach (var task in Model.Tasks)
                    {
                        <div class="col-lg-4 col-md-6 mb-4 project-card"
                             data-name="@task.Title.ToLower()"
                             data-active="@(task.IsActive.ToString().ToLower())"
                             data-status="@task.StatusDisplay">
                            <div class="card h-100 shadow-sm">

                                <!-- Header: title + badge inline -->
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0">
                                        <a asp-page="/Shared/Projects/ProjectTasks/Upsert"
                                           asp-route-projectId="@Model.ProjectId"
                                           asp-route-projectTaskId="@task.Id"
                                           class="link-primary text-decoration-none link-underline-opacity-0-hover">
                                        @task.Title
                                        </a>
                                    </h5>
                                    <span class="badge @task.StatusBadgeClass">
                                        @task.StatusDisplay
                                    </span>
                                </div>

                                <div class="card-body d-flex flex-column">

                                    <!-- Truncated description -->
                                    <p class="card-text flex-grow-1 text-truncate">
                                        @task.Description
                                    </p>

                                    <!-- Metadata with icons -->
                                    <ul class="list-unstyled mb-3 small text-muted">
                                        <li>
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @(task.StartDate?.ToString("MMM d, yyyy") ?? "TBD")
                                        </li>
                                        <li>
                                            <i class="bi bi-hourglass-split me-1"></i>
                                             @(task.EndDate?.ToString("MMM d, yyyy") ?? "TBD")
                                        </li>
                                    </ul>

                                    @* <!-- Status badge pinned bottom (optional duplicate) -->
                                    <div class="mt-auto">
                                        <span class="badge @(project.IsActive ? "bg-success" : "bg-secondary")">
                                            @project.StatusDisplay
                                        </span>
                                    </div> *@

                                </div><!-- /.card-body -->
                            </div><!-- /.card -->
                        </div>
        
                        <!-- /.col -->
                    }
                </div><!-- /.row -->
            </div>
        </div>
    </div>
</div>
@section Scripts {
  <script>
    (function() {
        const cards         = Array.from(document.querySelectorAll('.project-card'));
        const statusFilter  = document.getElementById('statusFilter');
        const txtSearch     = document.getElementById('searchInput');
        const btnSearch     = document.getElementById('searchButton');
        const container     = document.getElementById('projectsContainer');
        const messageId     = 'noResultsMessage';

        function applyFilters() {
        const selectedStatus = statusFilter.value;         // e.g. "Active" or "All"
        const term           = txtSearch.value.trim().toLowerCase();

        // 1) Show/hide cards
        cards.forEach(card => {
            const name   = card.dataset.name;
            const status = card.dataset.status;              // e.g. "Active"

            let visible = true;
            if (selectedStatus !== 'All' && status !== selectedStatus) {
            visible = false;
            }
            if (term && !name.includes(term)) {
            visible = false;
            }

            card.style.display = visible ? '' : 'none';
        });

        // 2) “No results” message
        const anyVisible = cards.some(c => c.style.display !== 'none');
        const existing   = document.getElementById(messageId);
        if (!anyVisible) {
            if (!existing) {
            const msg = document.createElement('div');
            msg.id        = messageId;
            msg.className = 'alert alert-info text-center mt-4';
            msg.textContent = 'No tasks match your filters.';
            container.parentNode.insertBefore(msg, container);
            }
        } else if (existing) {
            existing.remove();
        }
        }

        // wire up events
        statusFilter.addEventListener('change', applyFilters);
        btnSearch.addEventListener   ('click',  applyFilters);
        txtSearch.addEventListener   ('keyup',  e => e.key === 'Enter' && applyFilters());

        // initial
        applyFilters();
    })();
  </script>
}
