@page "/Shared/Projects/{projectId:int}/ProjectTasks/{projectTaskId?}"
@model RVPark.Pages.Projects.Tasks.UpsertModel
@{
    var isEdit = Model.Task.Id > 0;
    string pageTitle = isEdit
      ? $"{Model.Project.Title} - {Model.Task.Title}"
      : $"{Model.Project.Title} - New Task";
}

<div class="container my-4">
    <div class="card col-md-10 offset-1 my-3 px-5 py-3">
        <div class="row mb-4">
            <a asp-page="/Shared/Projects/ProjectTasks/Index"
               asp-route-projectId="@Model.ProjectId"
               class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover position-absolute top-0 start-0 m-4">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
        <div class="row">
            <div class="col-md-10 offset-1">
                <form method="post" class="my-4">
                    <h2 class="my-3">
                        <i class="bi bi-list-check me-1"></i>
                        @pageTitle
                    </h2>

                    <input type="hidden" asp-for="Task.Id" />
                    <input type="hidden" asp-for="Task.ProjectId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-md-6">
                            <label asp-for="Task.Title" class="form-label"></label>
                            <input asp-for="Task.Title" class="form-control" />
                            <span asp-validation-for="Task.Title" class="text-danger"></span>
                        </div>

                        <!-- Start Date -->
                        <div class="col-md-6">
                            <label asp-for="Task.StartDate" class="form-label">Start Date</label>
                            <input asp-for="Task.StartDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Task.StartDate" class="text-danger"></span>
                        </div>

                        <!-- End Date -->
                        <div class="col-md-6">
                            <label asp-for="Task.EndDate" class="form-label">End Date</label>
                            <input asp-for="Task.EndDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Task.EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Description full‑width -->
                    <div class="mt-4">
                        <label asp-for="Task.Description" class="form-label"></label>
                        <textarea asp-for="Task.Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Task.Description" class="text-danger"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-4 d-flex">
                        <button type="submit" class="btn btn-primary">
                            @(isEdit ? "Save Changes" : "Create Task")
                        </button>
                        <a asp-page="Index"
                           asp-route-projectId="@Model.ProjectId"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>