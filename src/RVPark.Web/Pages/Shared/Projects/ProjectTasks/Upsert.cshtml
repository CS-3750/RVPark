@page "/Shared/Projects/{projectId:int}/ProjectTasks/{projectTaskId?}"
@model RVPark.Pages.Projects.Tasks.UpsertModel
@{
    var isEdit = Model.Task.Id > 0;
    string pageTitle = isEdit
      ? $"{Model.Project.Title} - {Model.Task.Title}"
      : $"{Model.Project.Title} - New Task";
}

<div class="container my-4">
    <div class="card col-md-10 offset-1 my-3 px-5 py-3">
        <div class="row mb-4">
            <a asp-page="/Shared/Projects/Upsert"
               asp-route-id="@Model.ProjectId"
               class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover position-absolute top-0 start-0 m-4">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
        <div class="row">
            <div class="col-md-10 offset-1">
                <form method="post" class="my-4">
                    <h2 class="my-3">
                        <i class="bi bi-list-check me-1"></i>
                        @pageTitle
                    </h2>

                    <input type="hidden" asp-for="Task.Id" />
                    <input type="hidden" asp-for="Task.ProjectId" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3">
                        <!-- Title -->
                        <div class="col-md-6">
                            <label asp-for="Task.Title" class="form-label"></label>
                            <input asp-for="Task.Title" class="form-control" />
                            <span asp-validation-for="Task.Title" class="text-danger"></span>
                        </div>

                        <!-- Start Date -->
                        <div class="col-md-6">
                            <label asp-for="Task.StartDate" class="form-label">Start Date</label>
                            <input asp-for="Task.StartDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Task.StartDate" class="text-danger"></span>
                        </div>

                        <!-- End Date -->
                        <div class="col-md-6">
                            <label asp-for="Task.EndDate" class="form-label">End Date</label>
                            <input asp-for="Task.EndDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Task.EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Description full‑width -->
                    <div class="mt-4">
                        <label asp-for="Task.Description" class="form-label"></label>
                        <textarea asp-for="Task.Description" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Task.Description" class="text-danger"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="mt-4 d-flex">
                        <button type="submit" class="btn btn-primary">
                            @(isEdit ? "Save Changes" : "Create Task")
                        </button>
                        <a asp-page="/Shared/Projects/Upsert"
                           asp-route-id="@Model.ProjectId"
                           class="btn btn-secondary ms-2">
                            Cancel
                        </a>
                    </div>
                </form>

                @if (isEdit)
                {
                    <!-- Time Tracking Section -->
                    <div class="card mt-4">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="bi bi-clock me-2"></i>
                                Time Tracking
                            </h5>
                            <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#timeEntryModal">
                                <i class="bi bi-plus-circle me-1"></i>
                                Log Time
                            </button>
                        </div>
                        <div class="card-body">
                            <div id="timeEntriesContainer">
                                <!-- Time entries will be loaded here -->
                            </div>
                            <div id="noTimeEntriesMessage" class="text-muted text-center p-3 d-none">
                                <i class="bi bi-clock me-2"></i>
                                No time entries recorded for this task yet.
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (isEdit)
{
    <!-- Time Entry Modal -->
    <div class="modal fade" id="timeEntryModal" tabindex="-1" aria-labelledby="timeEntryModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="timeEntryModalLabel">Log Time for Task</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="timeEntryForm">
                        <div class="mb-3">
                            <label for="timeEntryDate" class="form-label">Date</label>
                            <input type="date" class="form-control" id="timeEntryDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="timeEntryHours" class="form-label">Hours</label>
                            <input type="number" class="form-control" id="timeEntryHours" 
                                   min="0.25" max="24" step="0.25" 
                                   placeholder="e.g., 1.5" required>
                            <div class="form-text">Enter hours as decimal (e.g., 1.5 for 1 hour 30 minutes)</div>
                        </div>
                        <div class="mb-3">
                            <label for="timeEntryDescription" class="form-label">Description (optional)</label>
                            <textarea class="form-control" id="timeEntryDescription" rows="3" placeholder="What did you work on?"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="saveTimeEntryButton">Log Time</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    @if (isEdit)
    {
        <script>
            const taskId = @Model.Task.Id;
            
            $(document).ready(function() {
                // Set today's date as default
                $('#timeEntryDate').val(new Date().toISOString().split('T')[0]);
                
                // Load existing time entries
                loadTimeEntries();
            });

            // Load time entries for the task
            async function loadTimeEntries() {
                try {
                    const response = await fetch(`/api/timetracking/task/${taskId}/entries`);
                    if (!response.ok) throw new Error('Failed to load time entries');
                    
                    const entries = await response.json();
                    renderTimeEntries(entries);
                } catch (error) {
                    console.error('Error loading time entries:', error);
                    showAlert('Error loading time entries', 'danger');
                }
            }

            // Render time entries in the UI
            function renderTimeEntries(entries) {
                const container = $('#timeEntriesContainer');
                const noEntriesMsg = $('#noTimeEntriesMessage');
                
                if (entries.length === 0) {
                    container.empty();
                    noEntriesMsg.removeClass('d-none');
                    return;
                }
                
                noEntriesMsg.addClass('d-none');
                container.empty();
                
                entries.forEach(entry => {
                    const entryDate = new Date(entry.date).toLocaleDateString();
                    const entryHtml = `
                        <div class="border-bottom py-2">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="fw-semibold">${entry.formattedHours} on ${entryDate}</div>
                                    <div class="text-muted small">by ${entry.fullName || entry.userName}</div>
                                    ${entry.description ? `<div class="mt-1">${entry.description}</div>` : ''}
                                </div>
                                <small class="text-muted">${new Date(entry.createdAt).toLocaleDateString()}</small>
                            </div>
                        </div>
                    `;
                    container.append(entryHtml);
                });
            }

            // Save time entry
            $('#saveTimeEntryButton').click(async function() {
                const date = $('#timeEntryDate').val();
                const hours = parseFloat($('#timeEntryHours').val());
                const description = $('#timeEntryDescription').val().trim();
                
                if (!date || !hours) {
                    showAlert('Please fill in all required fields', 'warning');
                    return;
                }
                
                try {
                    const response = await fetch('/api/timetracking/entry', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            projectTaskId: taskId,
                            hours: hours,
                            date: date,
                            description: description || null
                        })
                    });
                    
                    if (!response.ok) throw new Error('Failed to save time entry');
                    
                    showAlert('Time entry logged successfully!', 'success');
                    $('#timeEntryModal').modal('hide');
                    resetTimeEntryForm();
                    loadTimeEntries(); // Refresh the list
                    
                } catch (error) {
                    console.error('Error saving time entry:', error);
                    showAlert('Error saving time entry: ' + error.message, 'danger');
                }
            });

            // Reset time entry form
            function resetTimeEntryForm() {
                document.getElementById('timeEntryForm').reset();
                $('#timeEntryDate').val(new Date().toISOString().split('T')[0]);
            }

            // Utility function to show alerts
            function showAlert(message, type) {
                const alertHtml = `
                    <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                        ${message}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
                $('.container').prepend(alertHtml);
                
                // Auto-dismiss after 5 seconds
                setTimeout(() => {
                    $('.alert').alert('close');
                }, 5000);
            }
        </script>
    }
}