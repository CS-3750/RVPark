@page "{id?}"
@model UpsertModel
@{
    var isNew = Model.Project.Id == 0;
    var pageTitle = isNew ? "New Project" : Model.Project.Title;
}
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">@pageTitle</h1>
        <!-- toggles view vs edit -->
        <button id="editToggleBtn"
                class="btn @(isNew ? "btn-primary" : "btn-outline-primary")">
            <i class="bi @(isNew ? "bi-plus-lg" : "bi-pencil") me-1"></i>
            @(isNew ? "Create" : "Edit")
        </button>
    </div>

    <!-- VIEW MODE -->
    <div id="viewMode" class="card mb-4 shadow-sm @((!isNew) ? "" : "d-none")">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Title</dt>
                <dd class="col-sm-9">@Model.Project.Title</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Project.Description</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Project.IsActive ? "bg-success" : "bg-secondary")">
                        @Model.Project.StatusDisplay
                    </span>
                </dd>

                <dt class="col-sm-3">Owner</dt>
                <dd class="col-sm-9">@Model.Project.Name</dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">
                    @(Model.Project.StartDate?.ToString("MMM d, yyyy") ?? "TBD")
                </dd>

                <dt class="col-sm-3">Est. End</dt>
                <dd class="col-sm-9">
                    @(Model.Project.EstimatedEndDate?.ToString("MMM d, yyyy") ?? "TBD")
                </dd>

                @if (Model.Project.EndDate.HasValue)
                {
                    <dt class="col-sm-3">Completed</dt>
                    <dd class="col-sm-9">
                        @Model.Project.EndDate.Value.ToString("MMM d, yyyy")
                    </dd>
                }
            </dl>
        </div>
    </div>

    <!-- EDIT MODE -->
    <div id="editMode" class="card mb-4 shadow-sm @((isNew) ? "" : "d-none")">
        <div class="card-body">
            <form method="post">
                <input type="hidden" asp-for="Project.Id" />

                <div class="mb-3 row">
                    <label asp-for="Project.Title" class="col-sm-3 col-form-label">Title</label>
                    <div class="col-sm-9">
                        <input asp-for="Project.Title" class="form-control" />
                        <span asp-validation-for="Project.Title" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.Description" class="col-sm-3 col-form-label">Description</label>
                    <div class="col-sm-9">
                        <textarea asp-for="Project.Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Project.Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.StatusEnum" class="col-sm-3 col-form-label">Status</label>
                    <div class="col-sm-9">
                        <select asp-for="Project.StatusEnum"
                                asp-items="Model.StatusOptions"
                                class="form-select">
                        </select>
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.Name" class="col-sm-3 col-form-label">Owner</label>
                    <div class="col-sm-9">
                        <input asp-for="Project.Name" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.StartDate" class="col-sm-3 col-form-label">Start Date</label>
                    <div class="col-sm-9">
                        <input asp-for="Project.StartDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.EstimatedEndDate" class="col-sm-3 col-form-label">Est. End</label>
                    <div class="col-sm-9">
                        <input asp-for="Project.EstimatedEndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 row">
                    <label asp-for="Project.EndDate" class="col-sm-3 col-form-label">Completed</label>
                    <div class="col-sm-9">
                        <input asp-for="Project.EndDate" type="date" class="form-control" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="button" id="cancelEditBtn" class="btn btn-secondary me-2">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function() {
          var viewEl   = document.getElementById("viewMode");
          var editEl   = document.getElementById("editMode");
          var toggle   = document.getElementById("editToggleBtn");
          var cancel   = document.getElementById("cancelEditBtn");

          function showEdit() {
            viewEl.classList.add("d-none");
            editEl.classList.remove("d-none");
            toggle.disabled = true;
          }
          function showView() {
            editEl.classList.add("d-none");
            viewEl.classList.remove("d-none");
            toggle.disabled = false;
          }

          toggle.addEventListener("click", showEdit);
          cancel.addEventListener ("click", showView);

          // If it’s a “New” project, drop directly into edit mode
          @if (Model.Project.Id == 0)
        {
                <text>
                  showEdit();
                </text>
          }
        })();
    </script>
}
