@page "/Shared/Projects/{id?}"
@model UpsertModel
@using RVPark.Core.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Build.Evaluation
@using Newtonsoft.Json
@using System.Web

@{
    var ganttTasks = Model.Tasks.Select(task => new
    {
        id = task.Id.ToString(),
        name = task.Title,
        start = task.StartDate?.ToString("yyyy-MM-dd") ?? "",
        end = task.EndDate?.ToString("yyyy-MM-dd") ?? "",
        progress = task.IsCompleted ? 100 : 0,
        dependencies = "",
    });
    var tasks = Model.Tasks.Select(task => new
    {
        id = task.Id.ToString(),
        projectId = Model.Project.Id,
        description = task.Description,
        title = task.Title,
        startDate = task.StartDate,
        endDate = task.EndDate,
        isScheduled = task.IsScheduled,
        isActive = task.IsActive,
        isCompleted = task.IsCompleted,
        statusDisplay = task.StatusDisplay,
        statusBadgeClass = task.StatusBadgeClass,
    });
    var tasksJson = JsonConvert.SerializeObject(tasks);
    var ganttTasksJson = JsonConvert.SerializeObject(ganttTasks);
}

<div class="container my-4">
    <div class="card col-md-10 offset-1 mt-3 px-5 py-3">
        <div class="row mb-4">
            <a asp-page="/Shared/Projects/Index"
               class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover position-absolute top-0 start-0 m-4">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
        <form method="post">
            <input type="hidden" asp-for="Project.Id" />
            <input type="hidden" asp-for="Project.Name" />
            <input type="hidden" asp-for="Project.LeadInternId" />

            <div class="row">
                <div class="col-md-10 offset-1 my-3">
                    <div class="row my-3 align-items-center">
                        <!-- Title -->
                        <div class="col-md-8 inline-edit" data-field="Title">

                            <div class="view d-flex align-items-center h1">
                                <i class="bi bi-folder-plus me-3"></i>
                                <span>@Model.Project.Title</span>
                            </div>
                            <div class="edit d-none input-group input-group-lg">
                                <span class="input-group-text"><i class="bi bi-folder-plus"></i></span>
                                <input asp-for="Project.Title" class="form-control" />
                            </div>
                            <span asp-validation-for="Project.Title" class="text-danger"></span>

                            @* <i class="bi bi-folder-plus h1 pe-3"></i>
                                <span class="view h1">@Model.Project.Title</span>
                                <input asp-for="Project.Title" class="edit form-control h1 d-none" />
                                <span asp-validation-for="Project.Title" class="text-danger"></span> *@
                        </div>

                        <!-- Status -->
                        <div class="col-auto ms-auto inline-edit" data-field="StatusEnum">
                            <div class="view d-flex justify-content-end">
                                <!-- Enlarged badge using fs-1 and extra padding -->
                                <span class="badge fs-3 py-2 px-3 @(Model.Project.IsActive ? "bg-success" : "bg-secondary")">
                                    @Model.Project.StatusDisplay
                                </span>
                            </div>
                            <select asp-for="Project.StatusEnum" asp-items="Model.StatusOptions" class="edit form-select d-none"></select>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="row p-3 mb-3 inline-edit" data-field="Description">
                        <span class="view form-control d-block">@Model.Project.Description</span>
                        <textarea asp-for="Project.Description" class="edit form-control d-none" rows="4"></textarea>
                        <span asp-validation-for="Project.Description" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12 mb-3 d-flex text-center justify-content-around">
                            <!-- Start Date -->
                            <div class="row mx-1 inline-edit" data-field="StartDate">
                                <label class="form-label">Start Date</label>
                                <div class="view form-control d-block">
                                    <span>@(Model.Project.StartDate?.ToString("MMM d, yyyy") ?? "TBD")</span>
                                    <i class="bi bi-calendar-event ms-1"></i>
                                </div>
                                <input asp-for="Project.StartDate" type="date" class="edit form-control d-none" />
                            </div>

                            <!-- Estimated End Date -->
                            <div class="row mx-1 inline-edit" data-field="EstimatedEndDate">
                                <label class="form-label">Estimated End Date</label>
                                <div class="view form-control d-block">
                                    <span>@(Model.Project.EstimatedEndDate?.ToString("MMM d, yyyy") ?? "TBD")</span>
                                    <i class="bi bi-hourglass-split ms-1"></i>
                                </div>
                                <input asp-for="Project.EstimatedEndDate" type="date" class="edit form-control d-none" />
                            </div>

                            <!-- Completion Date -->
                            <div class="row mx-1 inline-edit" data-field="EndDate">
                                <label class="form-label">Completion Date</label>
                                <div class="view form-control d-block">
                                    <span>@(Model.Project.EndDate?.ToString("MMM d, yyyy") ?? "TBD")</span>
                                    <i class="bi bi-check2-circle ms-1"></i>
                                </div>
                                <input asp-for="Project.EndDate" type="date" class="edit form-control d-none" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </div>
            </div>
        </form>
        @if (Model.Project.Id != 0)
        {
            <div class="card col-md-12 mt-3 px-5 py-3">
                <div class="row my-3">
                    <div class="col-md-12">
                        <!-- Page Title -->
                        <div class="row my-3">
                            <div class="col-md-9">
                                <h2 class="mb-3">
                                    <i class="bi bi-list-check me-2"></i>
                                    Tasks
                                </h2>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <select id="taskViewSelect"class="form-select">
                                        <option value="gantt" selected>Gantt</option>
                                        <option value="card">Card</option>
                                    </select>
                                    <span class="input-group-text">View</span>
                                </div>
                            </div>
                        </div>

                        <!-- Filters + Search -->
                        <div class="row mb-4 gy-2 gx-3 align-items-center">
                            <div class="col-auto">
                                <div class="input-group">
                                    <span class="input-group-text">Status</span>
                                    <select id="statusFilter" class="form-select">
                                        <option value="All" selected>All</option>
                                        <option value="Scheduled">Scheduled</option>
                                        <option value="Active">Active</option>
                                        <option value="Completed">Completed</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-auto ms-auto d-flex align-items-center flex-nowrap">
                                <div class="input-group">
                                    <input type="text" id="searchInput" class="form-control" placeholder="Search project tasks..." />
                                    <button class="btn btn-outline-secondary" id="searchButton">Search</button>
                                </div>
                                <a asp-page="/Shared/Projects/ProjectTasks/Upsert"
                                   asp-route-projectId="@Model.Project.Id"
                                   asp-route-projectTaskId=0
                                   class="btn btn-primary ms-2 text-nowrap">
                                    <i class="bi bi-list-check me-1"></i>
                                    New Task
                                </a>
                            </div>
                        </div>
                        <div class="row">
                            <div id="gantt"></div>
                            <div id="ganttNoEndDateAlert" class="row d-flex justify-content-end d-none"></div>
                            <div id="tasksContainer" class="row d-none"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 mt-5 mb-2">
                <div class="row justify-content-evenly">
                    <a asp-page="./AssetRequest" asp-route-projectId="@Model.Project.Id" class="card col-md-4 py-3 btn btn-secondary text-decoration-none">
                        <h3>
                            <i class="bi bi-box-seam me-2"></i>
                            Asset Requests
                        </h3>
                    </a>
                    <a asp-page="./Files" asp-route-projectId="@Model.Project.Id" class="card col-md-4 py-3 btn btn-primary text-decoration-none">
                        <h3>
                            <i class="bi bi-file-earmark-arrow-down me-2"></i>
                            Files
                        </h3>
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let tasksJson = @Html.Raw(tasksJson);
        let gantt;
        let ganttRefreshTimeout;
        let sendTaskUpdateTimeout;
        let dragResetTimeout;
        let wasDragged = false;

        const renderCards = (tasks) => {
            const $container = $('#tasksContainer').empty();
            tasks.forEach(t => {
                $container.append(cardHtmlFor(t));
            });
        }

        const updateCard = (t) => {
            const newHtml = cardHtmlFor(t);
            const $old = $('#task-' + t.id);
            if ($old.length) {
                $old.replaceWith(newHtml);
            } else {
                $('#tasksContainer').append(newHtml);
            }

        }

        const cardHtmlFor = (t) => {
            let formattedStartDate;
            let formattedEndDate;
            if (!t.startDate) {
                formattedStartDate = "TBD";
            } else {
                const originalStartDate = new Date(t.startDate);
                formattedStartDate = originalStartDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                });
            }
            if (!t.endDate) {
                formattedEndDate = "TBD";
            } else {
                const originalEndDate = new Date(t.endDate);
                formattedEndDate = originalEndDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric'
                });
            }
            return `
                <div id="task-${t.id}" class="col-lg-4 col-md-6 mb-4 project-card"
                     data-name="${t.title.toLowerCase()}"
                     data-active="${t.isActive.toString().toLowerCase()}"
                     data-status="${t.statusDisplay}">
                    <div class="card h-100 shadow-sm">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <a href="/Shared/Projects/${t.projectId}/ProjectTasks/${t.id}"
                                   class="link-primary text-decoration-none link-underline-opacity-0-hover">
                                    ${t.title}
                                </a>
                            </h5>
                            <span class="badge ${t.statusBadgeClass}">${t.statusDisplay}</span>
                        </div>
                        <div class="card-body d-flex flex-column">
                            <p class="card-text flex-grow-1 text-truncate">${t.description}</p>
                            <ul class="list-unstyled mb-3 small text-muted">
                                <li><i class="bi bi-calendar-event me-1"></i>${formattedStartDate}</li>
                                <li><i class="bi bi-hourglass-split me-1"></i>${formattedEndDate}</li>
                            </ul>
                        </div>
                    </div>
                </div>
            `;
        }

        const mapTasksToGantt = (tasks) => {
            const originalTasksCount = tasks.length;
            const ganttReady = tasks.filter(t => 
                t.startDate !== '' &&
                t.endDate !== '' &&
                !isNaN(Date.parse(t.startDate)) &&
                !isNaN(Date.parse(t.endDate))
            );
            const ganttReadyCount = ganttReady.length;
            const $alert = $('#ganttNoEndDateAlert');
            const missingCount = originalTasksCount - ganttReadyCount;
            const selectedView = $('#taskViewSelect').val();
            const showAlert = missingCount > 0 && selectedView === 'gantt';
            if (showAlert) {
                $alert.html(`
                    <div class="">
                        <div class="alert alert-light col-md-12 mt-3 d-flex justify-content-center" role="alert">
                            <div class="">
                                <div>
                                    <i class="bi bi-exclamation-triangle me-2"></i>
                                    ${missingCount} task${missingCount > 1 ? 's' : ''} ${missingCount > 1
                                    ? 'do'
                                    : 'does'} not have both start and end dates set and will not appear in the Gantt view.
                                </div>
                            </div>
                        </div>
                    </div>
                `);
            } else {
                $alert.empty();
            }
            $alert.toggleClass('d-none', !showAlert);
            return ganttReady.map(t => ({
                id: t.id,
                name: t.title,
                start: t.startDate ? new Date(t.startDate).toISOString().slice(0,10) : "",
                end: t.endDate ? new Date(t.endDate).toISOString().slice(0,10) : "",
                progress: t.isCompleted ? 100 : 0,
                dependencies: "",
            }));
        }

        const sendTaskUpdate = (task, start, end) => {
            let currentURL = window.location.pathname;
            let updateURL = `${currentURL}?handler=UpdateTask`
            fetch(updateURL, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                body: JSON.stringify({
                    id: task.id,
                    start: start.toISOString(),
                    end: end.toISOString()
                })
            })
            .then(res => {
                if(!res.ok) throw new Error("Save failed");
                return res.json();
            })
            .then(data => {
                if (!data.success) throw new Error("Save failed");
                const updated = data.task;
                updateCard(updated);
                const idx = tasksJson.findIndex(t => t.id === task.id);
                if (idx > -1) {
                    index = idx.toString();
                    tasksJson[index] = updated;
                }
                const ganttTask = gantt.tasks.find(t => t.id === task.id);
                if (ganttTask) {
                    ganttTask.start = new Date(start);
                    ganttTask.end = new Date(end);
                    const progress = data.task_complete ? 100 : 0;
                    ganttTask.progress = progress
                    if (ganttRefreshTimeout) {
                        clearTimeout(ganttRefreshTimeout);
                    }
                    ganttRefreshTimeout = setTimeout(() => {
                        let start = ganttTask.start ? ganttTask.start.toISOString().slice(0,10) : "";
                        let end = ganttTask.end ? ganttTask.end.toISOString().slice(0,10) : "";
                        gantt.update_task(ganttTask.id, {
                            start: start,
                            end: end,
                            progress: progress,
                        });
                    }, 200);
                    dragResetTimeout = setTimeout(() => {
                        wasDragged = false;
                    }, 300);

                }
            })
            .catch(err => {
                console.error(err);
            });
        }
        

        $(() => {
            renderCards(tasksJson);
            $('#taskViewSelect').on('change', () => {
                const selectedView = $('#taskViewSelect').val();
                const $ganttNoEndDateAlert = $('#ganttNoEndDateAlert');
                if (selectedView === 'gantt') {
                    $('#gantt').removeClass('d-none');
                    $('#tasksContainer').addClass('d-none');
                    $ganttNoEndDateAlert.toggleClass('d-none', $ganttNoEndDateAlert.text().trim() === '')
                } else {
                    $('#gantt').addClass('d-none');
                    $ganttNoEndDateAlert.addClass('d-none');
                    $('#tasksContainer').removeClass('d-none');
                }
            });
            let ganttTasks = mapTasksToGantt(tasksJson);
            gantt = new Gantt("#gantt", ganttTasks, {
                container_height: 'auto',
                column_width: 75,
                on_click: task => {
                    if (wasDragged) {
                        return;
                    }
                    let currentURL = window.location.pathname;
                    window.location.href = `${currentURL}/ProjectTasks/${task.id}`
                },
                on_date_change: (task, start, end) => {
                    wasDragged = true;
                    if (sendTaskUpdateTimeout) {
                        clearTimeout(sendTaskUpdateTimeout);
                    }
                    sendTaskUpdateTimeout = setTimeout(() => {
                        sendTaskUpdate(task, start, end);
                    }, 500);
                },
                popup_on: 'hover',
                scroll_to: "start",
                readonly_progress: true,
            });
        });
    </script>
    <script>
        document.querySelectorAll('.inline-edit').forEach(wrapper => {
          let editWithVal;
          let viewElWithVal;
          const viewEl = wrapper.querySelector('.view');
          const editEl = wrapper.querySelector('.edit');
          
          function refreshElsWithVals()
          {
              editElWithVal = editEl;
              viewElWithVal = viewEl;
              if (editEl.tagName === 'DIV') { editElWithVal = editEl.querySelector('input, textarea, select'); }
              if (viewEl.tagName === 'DIV') { viewElWithVal = viewEl.querySelector('span'); }
          }
          refreshElsWithVals();

          // On double-click, switch to edit
          wrapper.addEventListener('click', () => {
            viewEl.classList.add('d-none');
            editEl.classList.remove('d-none');
            refreshElsWithVals();
            editElWithVal.focus();
            if (typeof editElWithVal.setSelectionRange === 'function') 
            {
                const len = editElWithVal.value.length;
                editElWithVal.setSelectionRange(len, len);
            }
          });

          // Finish editing on blur or Enter
          function finishEdit() {
                refreshElsWithVals();

                let displayText;

                if (editElWithVal.type === 'date') {
                // this gives you a Date at local midnight, or null if blank
                const d = editElWithVal.valueAsDate;
                displayText = d
                    ? d.toLocaleDateString(undefined, {
                        month: 'short', day: 'numeric', year: 'numeric'
                    })
                    : 'TBD';
                }
                else {
                // trim out any stray spaces, then see if there's anything left
                const raw = editElWithVal.value.trim();
                displayText = raw === ''
                    ? 'TBD'
                    : raw;
                }

                // set the span
                viewElWithVal.textContent = displayText;

                // hide the editor, show the view
                editEl.classList.add('d-none');
                viewEl.classList.remove('d-none');
            }

          editElWithVal.addEventListener('blur', finishEdit);
          editElWithVal.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
              e.preventDefault();
              finishEdit();
            }
          });
        });
    </script>
    <script>
        (function() {
            const cards         = Array.from(document.querySelectorAll('.project-card'));
            const statusFilter  = document.getElementById('statusFilter');
            const txtSearch     = document.getElementById('searchInput');
            const btnSearch     = document.getElementById('searchButton');
            const container     = document.getElementById('tasksContainer');
            const messageId     = 'noResultsMessage';

            function applyFilters() {
                const selectedStatus = statusFilter.value;         // e.g. "Active" or "All"
                const term           = txtSearch.value.trim().toLowerCase();
                const filteredTasks = tasksJson.filter(t => {
                    const okStatus = selectedStatus === 'All' || t.statusDisplay === selectedStatus;
                    const okSearch = !term || t.title.toLowerCase().includes(term);
                    return okStatus && okSearch
                });
                renderCards(filteredTasks);
                const existing = document.getElementById(messageId);
                if (filteredTasks.length === 0) {
                    if (!existing) {
                        const msg = document.createElement('div');
                        msg.id        = messageId;
                        msg.className = 'alert alert-info text-center mt-4';
                        msg.textContent = 'No tasks match your filters.';
                        container.parentNode.insertBefore(msg, container);
                    }
                } else if (existing) {
                    existing.remove();
                }

                // 3) Apply Gantt Chart Filters
                if (!gantt) return;
                const ganttData = mapTasksToGantt(filteredTasks);

                gantt.refresh(ganttData);
            }

            // wire up events
            statusFilter.addEventListener('change', applyFilters);
            btnSearch.addEventListener   ('click',  applyFilters);
            txtSearch.addEventListener   ('keyup',  e => e.key === 'Enter' && applyFilters());

            // initial
            applyFilters();
        })();
    </script>
}
