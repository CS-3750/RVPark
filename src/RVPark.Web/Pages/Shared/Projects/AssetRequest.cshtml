@page
@using RVPark.Core.Models
@model RVPark.Web.Pages.Shared.Projects.AssetRequestModel

@{
}

<div class="container my-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card col-md-10 offset-1 mt-3 px-5 py-3">
        <div class="row mb-4">
            <a asp-page="/Shared/Projects/Upsert"
               asp-route-id="@Model.ProjectId"
               class="link-offset-2 link-offset-3-hover link-underline link-underline-opacity-0 link-underline-opacity-75-hover position-absolute top-0 start-0 m-4">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>
        </div>
        <h4 class="mt-4">New Asset Requests</h4>

        @* New Request *@
        <div class="list-group">
            <div class="list-group-item">
                <h5 class="mb-3">Create a New Request</h5>
                <form method="post" class="needs-validation" novalidate>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.Description">Description</label>
                                <input asp-for="Input.Description" class="form-control" />
                                <span asp-validation-for="Input.Description" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.Url">URL</label>
                                <input asp-for="Input.Url" class="form-control" />
                                <span asp-validation-for="Input.Url" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.Quantity">Quantity</label>
                                <input asp-for="Input.Quantity" class="form-control" type="number" />
                                <span asp-validation-for="Input.Quantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Input.EstimatedCost">Estimated Cost</label>
                                <input asp-for="Input.EstimatedCost" class="form-control" />
                                <span asp-validation-for="Input.EstimatedCost" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <input asp-for="Input.CreatedByApplicationUserId" type="hidden" />
                    <input asp-for="Input.ProjectId" type="hidden" />
                    <div class="form-group mt-3">
                        <button type="submit" class="btn btn-primary">Submit Request</button>
                    </div>
                </form>
            </div>
        </div>

        @* Previous Requests *@
        <div class="mt-5">
            <h4>Previous Requests</h4>
            <div class="list-group">
            @if (Model.PreviousRequests.Any())
            {
                foreach (var request in Model.PreviousRequests)
                {
                    <div class="list-group-item">
                        <h5 class="mb-1">@request.Description</h5>
                        <p class="mb-1">
                            <strong>Quantity:</strong> @request.Quantity |
                            <strong>URL:</strong> <a href="@request.Url" target="_blank">@request.Url</a> |
                            <strong>Estimated Cost:</strong> @request.EstimatedCost
                        </p>
                        <div class="d-flex mt-2 align-items-center">
                            <p><strong>Status:</strong></p>
                            <form method="post" asp-page-handler="UpdateStatus" class="mr-2" style="max-width: 250px;">
                                <input type="hidden" name="requestId" value="@request.Id"/>
                                <div class="input-group">
                                    <select name="status" asp-for="@request.Status" asp-items="Html.GetEnumSelectList<AssetRequestStatus>()" class="form-control" onchange="this.form.submit()"></select>
                                </div>
                            </form>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="list-group-item text-center">
                    No previous asset requests found. Create one to get started!
                </div>
            }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

