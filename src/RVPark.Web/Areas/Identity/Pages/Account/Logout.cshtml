@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="container my-4">
                <div class="card col offset-3 my-3 px-5 py-3">
                    <div class="col-md-8 offset-2 my-3">
                        <img class="icon-dark" src="~/images/wsu_concept_center_logo.svg" alt="Concept Center Logo"/>
                    </div>
                    <div class="col-md-8 offset-2 my-4 text-center">
                        <h4 class="text-secondary">Are you sure you want to log out?</h4>
                    </div>
                    <form method="post" action="/Identity/Account/Logout">
                        <div class="col-md-8 offset-2 d-flex justify-content-evenly text-center mt-3">
                            <a class="btn btn-lg btn-secondary px-4" asp-page="/Shared/Projects/Index">
                                <i class="bi bi-x-circle me-1"></i>
                                Cancel
                            </a>
                            <button class="btn btn-lg btn-danger px-4" type="submit">
                                <i class="bi bi-door-open me-1"></i>
                                Logout
                            </button>
                        </div>    
                    </form>
                </div>
            </div>
        }
        else
        {
            <p>You have successfully logged out of the application.</p>
        }
    }
</header>
