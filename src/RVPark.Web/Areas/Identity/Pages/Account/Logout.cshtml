@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <div class="container my-4">
                <div class="card col-md-6 offset-3 my-3 px-5 py-3">
                    <div class="row my-4">
                        <form 
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Page("/", new { area = "" })" 
                          method="post">
                            <div class="col-md-8 offset-2 mt-5 mb-5">
                                <img class="icon-dark" src="~/images/wsu_concept_center_logo.svg" alt="Concept Center Logo"/>
                            </div>
                            <div class="col-md-8 offset-2 mb-5 text-center">
                                <h5 class="text-secondary">Are you sure you want to log out?</h5>
                            </div>
                            <div class="col-md-8 offset-2 d-flex justify-content-evenly text-center mb-4">
                                <a class="btn btn-lg btn-secondary px-4" asp-page="/Shared/Projects/Index">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel
                                </a>
                                <button class="btn btn-lg btn-danger px-4" type="submit">
                                    <i class="bi bi-door-open me-1"></i>
                                    Logout
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <p>You have successfully logged out of the application.</p>
        }
    }
</header>
